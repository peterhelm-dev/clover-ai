# --- Server ---------------------------------------------------------------
# Supabase project → Settings → Database → Connection string (use the
# "Transaction" pooler URI on port 6543 for serverless-friendly connections).
# If your password has special characters (# % / : @ ? &), percent-encode
# them — e.g. via `node -e "console.log(encodeURIComponent('your-password'))"`.
DATABASE_URL=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres

# Supabase project → Settings → API. SUPABASE_URL is the bare project URL —
# do not append /rest/v1/ or any other path.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket for food-photo uploads (create it in Supabase Storage; private is fine).
SUPABASE_STORAGE_BUCKET=food-photos

# The Supabase Auth user id (uuid) of the app owner — grants admin role +
# unlimited AI calls. Find it in Supabase → Authentication → Users after
# your first login.
OWNER_OPEN_ID=
# Any account with this email gets admin + unlimited AI, regardless of provider.
OWNER_EMAIL=

ANTHROPIC_API_KEY=

# --- Email (paid beta program: daily tester emails) -------------------------
# resend.com → API Keys. Without it, emails are logged to the console instead.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Clover <beta@yourdomain.com>".
EMAIL_FROM=
# Public URL used in email links, canonical tags, and the sitemap (no trailing slash).
# Requests to the old Railway hostnames 301 here when this host differs from theirs.
APP_URL=https://getclover.app
# Any long random string; signs one-click unsubscribe links.
EMAIL_LINK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Railway sets PORT automatically — do not set it manually in production.
PORT=3000
# Do not set NODE_ENV=development on Railway. If it is set during `vite build`,
# Vite emits a development client bundle (large, unminified, source paths).
# `pnpm build` and `pnpm start` force production. Leave this unset in production.

# Footer link for logged-out visitors. mailto: or an https:// form URL.
# The placeholder is shown until you replace it.
PUBLIC_FEEDBACK_URL=mailto:feedback@example.com

# --- Client (must be prefixed VITE_ to be exposed to the browser) ---------
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=
